PID /proc/18959 /bin/sh -c #!/bin/sh
echo "=== date ==="
date
echo "=== processes ==="
ps auxww | grep -E 'jolla-camera|booster|lipstick|minisf|minimedia|droid' | grep -v grep
echo "=== maps ==="
for d in /proc/[0-9]*; do
  c=$(tr '\000' ' ' < "$d/cmdline" 2>/dev/null)
  case "$c" in
    *jolla-camera*|*booster-silica-qt5*)
      echo "PID $d $c"
      grep -E 'libgstdroid|libgui.so|libmemalloc|camera.qsd8k' "$d/maps" 2>/dev/null
      tr '\000' '\n' < "$d/environ" 2>/dev/null | grep -E 'GST_|QT_|LD_' ;;
  esac
done
echo "=== logs ==="
journalctl -b -n 800 --no-pager | grep -Ei 'camera|gstreamer|droidcam|camerabin|videoSink|negotia|wrong format|stream error' | tail -n 250
echo "=== android ==="
export LD_LIBRARY_PATH=/usr/libexec/droid-hybris/lib-dev-alog:/usr/libexec/droid-hybris/system/lib:/system/lib:/system/lib/egl
/usr/libexec/droid-hybris/system/bin/logcat -d -t 1000 -v threadtime | grep -Ei 'camera|bufferqueue|gralloc|mdp|preview|minisf' | tail -n 300
echo "=== fb ==="
dd if=/dev/graphics/fb0 of=/data/local/tmp/hd2-current-fb.raw bs=1536000 count=2
chmod 0644 /data/local/tmp/hd2-current-fb.raw

